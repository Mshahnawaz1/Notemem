{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notemem",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    // The assets layer would redirect this `.html` path to drop the extension, and Google's site
    // verification needs a 200 at the exact URL, so the Worker serves it (see src/index.ts).
    "run_worker_first": ["/google1e24adb1266cf4fc.html"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}